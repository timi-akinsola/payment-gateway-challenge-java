<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
  <!-- Allow constructor injection -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP2" />
    <Or>
      <Class name="com.checkout.payment.gateway.client.BankClient" />
      <Class name="com.checkout.payment.gateway.service.PaymentGatewayService" />
    </Or>
  </Match>

  <!-- Use \n for newline, not \r\n or %n -->
  <Match>
    <Bug pattern="VA_FORMAT_STRING_USES_NEWLINE" />
    <Class name="com.checkout.payment.gateway.integration.PaymentGatewayIntegrationTest" />
  </Match>
</FindBugsFilter>